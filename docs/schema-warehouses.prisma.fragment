// Add warehouseStocks WarehouseStock[] and warehouseAllocations OrderAllocation[] to Product.
// Add allocations OrderAllocation[] to Order.
// Add warehouseId String? @map("warehouse_id") @db.Uuid and warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict) to PurchaseOrder.
// Add warehouseId String? @map("warehouse_id") @db.Uuid and warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict) to StockMovement.
// Add WAREHOUSE_TRANSFER to StockMovementType.
enum AllocationState {
  RESERVED
  CONSUMED
  RELEASED
  RETURNED
}
model Warehouse {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(150)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  stocks WarehouseStock[]
  allocations OrderAllocation[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  @@map("warehouses")
}
model WarehouseStock {
  id String @id @default(uuid()) @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Int @default(0)
  reserved Int @default(0)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stocks")
}
model OrderAllocation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  quantity Int
  state AllocationState @default(RESERVED)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  @@unique([orderId, productId, warehouseId])
  @@index([productId, state])
  @@index([warehouseId, state])
  @@map("order_allocations")
}
