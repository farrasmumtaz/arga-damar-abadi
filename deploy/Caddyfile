{$APP_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  # Only this signed provider callback bypasses the frontend BFF.
  handle /api/v1/payments/webhooks/midtrans {
    request_body { max_size 256KB }
    reverse_proxy api:3000
  }
  handle {
    request_body { max_size 7MB }
    reverse_proxy web:3001
  }
}
