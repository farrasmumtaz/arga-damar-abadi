// Merge these fields into existing models:
// User: promotionRedemptions PromotionRedemption[]
// Order: promotionCode String? @map("promotion_code") @db.VarChar(40)
// Order: redemption PromotionRedemption?

enum DiscountKind {
  FIXED
  PERCENTAGE
}

model Promotion {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(150)
  kind DiscountKind
  amount Decimal @db.Decimal(15, 2)
  minSubtotal Decimal @default(0) @map("min_subtotal") @db.Decimal(15, 2)
  maxDiscount Decimal? @map("max_discount") @db.Decimal(15, 2)
  startsAt DateTime @map("starts_at")
  endsAt DateTime @map("ends_at")
  isActive Boolean @default(true) @map("is_active")
  usageLimit Int @map("usage_limit")
  perUserLimit Int @default(1) @map("per_user_limit")
  usedCount Int @default(0) @map("used_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  redemptions PromotionRedemption[]
  @@index([isActive, endsAt])
  @@map("promotions")
}

model PromotionRedemption {
  id String @id @default(uuid()) @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  discountAmount Decimal @map("discount_amount") @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([promotionId, userId])
  @@index([userId, createdAt])
  @@map("promotion_redemptions")
}

// Add PURCHASE_RECEIPT to StockMovementType.
// Add purchaseOrderItems PurchaseOrderItem[] to Product.

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  RECEIVED
  CANCELLED
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(150)
  contactName String? @map("contact_name") @db.VarChar(150)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(32)
  address String? @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  purchaseOrders PurchaseOrder[]
  @@index([isActive, name])
  @@map("suppliers")
}

model PurchaseOrder {
  warehouseId String? @map("warehouse_id") @db.Uuid
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  purchaseNumber String @unique @map("purchase_number") @db.VarChar(40)
  supplierId String @map("supplier_id") @db.Uuid
  supplierName String @map("supplier_name") @db.VarChar(150)
  actorId String @map("actor_id") @db.Uuid
  status PurchaseOrderStatus @default(DRAFT)
  total Decimal @db.Decimal(15, 2)
  note String? @db.VarChar(500)
  issuedAt DateTime? @map("issued_at")
  receivedAt DateTime? @map("received_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items PurchaseOrderItem[]
  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  sku String @db.VarChar(80)
  productName String @map("product_name") @db.VarChar(200)
  quantity Int
  unitCost Decimal @map("unit_cost") @db.Decimal(15, 2)
  subtotal Decimal @db.Decimal(15, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum StockMovementType {
  WAREHOUSE_TRANSFER
  ADJUSTMENT
  REFUND_RESTOCK
  PURCHASE_RECEIPT
}

enum QuotationStatus {
  SUBMITTED
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  warehouseTransfers WarehouseTransfer[]
  whatsappOptInAt DateTime? @map("whatsapp_opt_in_at")
  promotionRedemptions PromotionRedemption[]
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  phone         String?        @unique @db.VarChar(32)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  fullName      String         @map("full_name") @db.VarChar(150)
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true) @map("is_active")
  emailVerified DateTime?      @map("email_verified")
  tokenVersion  Int            @default(0) @map("token_version")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  accountTokens AccountToken[]
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  quotations    Quotation[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  stockMovements StockMovement[]
  orderStatusHistories OrderStatusHistory[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum AccountTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

model AccountToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  purpose AccountTokenPurpose
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_tokens")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(120)
  slug      String     @unique @db.VarChar(140)
  isActive  Boolean    @default(true) @map("is_active")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  logoUrl   String?   @map("logo_url") @db.VarChar(500)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([isActive, name])
  @@map("brands")
}

model Product {
  warehouseTransfers WarehouseTransfer[]
  warehouseStocks WarehouseStock[]
  warehouseAllocations OrderAllocation[]
  purchaseOrderItems PurchaseOrderItem[]
  id               String          @id @default(uuid()) @db.Uuid
  categoryId       String          @map("category_id") @db.Uuid
  brandId          String?         @map("brand_id") @db.Uuid
  sku              String          @unique @db.VarChar(80)
  name             String          @db.VarChar(200)
  slug             String          @unique @db.VarChar(220)
  shortDescription String?         @map("short_description") @db.VarChar(500)
  description      String?
  specifications   Json            @default("{}")
  price            Decimal         @db.Decimal(15, 2)
  weightGram       Int             @default(0) @map("weight_gram")
  status           ProductStatus   @default(DRAFT)
  isFeatured       Boolean         @default(false) @map("is_featured")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand            Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  inventory        Inventory?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  quotationItems   QuotationItem[]
  stockMovements   StockMovement[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inventory {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @unique @map("product_id") @db.Uuid
  quantity      Int      @default(0)
  reserved      Int      @default(0)
  lowStockLevel Int      @default(5) @map("low_stock_level")
  updatedAt     DateTime @updatedAt @map("updated_at")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

model StockMovement {
  warehouseId String? @map("warehouse_id") @db.Uuid
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  actorId        String            @map("actor_id") @db.Uuid
  type           StockMovementType @default(ADJUSTMENT)
  quantityBefore Int               @map("quantity_before")
  quantityDelta  Int               @map("quantity_delta")
  quantityAfter  Int               @map("quantity_after")
  reason         String            @db.VarChar(300)
  createdAt      DateTime          @default(now()) @map("created_at")
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor          User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([actorId, createdAt])
  @@map("stock_movements")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String   @db.VarChar(50)
  recipient   String   @db.VarChar(150)
  phone       String   @db.VarChar(32)
  addressLine String   @map("address_line") @db.VarChar(500)
  province    String   @db.VarChar(100)
  city        String   @db.VarChar(100)
  district    String   @db.VarChar(100)
  postalCode  String   @map("postal_code") @db.VarChar(10)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Order {
  allocations OrderAllocation[]
  promotionCode String? @map("promotion_code") @db.VarChar(40)
  redemption PromotionRedemption?
  quotationId String? @unique @map("quotation_id") @db.Uuid
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(40)
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(15, 2)
  shippingCost    Decimal     @map("shipping_cost") @db.Decimal(15, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(15, 2)
  total           Decimal     @db.Decimal(15, 2)
  shippingAddress Json        @map("shipping_address")
  customerNote    String?     @map("customer_note") @db.VarChar(500)
  shippingProvider String?    @map("shipping_provider") @db.VarChar(80)
  trackingNumber   String?    @map("tracking_number") @db.VarChar(120)
  shippingTrackingId String? @map("shipping_tracking_id") @db.VarChar(120)
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")
  cancelledAt       DateTime? @map("cancelled_at")
  idempotencyKey  String      @unique @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]
  statusHistories OrderStatusHistory[]
  refundRequest RefundRequest?

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  actorId   String?     @map("actor_id") @db.Uuid
  fromStatus OrderStatus @map("from_status")
  toStatus   OrderStatus @map("to_status")
  note       String?     @db.VarChar(300)
  createdAt  DateTime    @default(now()) @map("created_at")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@map("order_status_histories")
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  sku         String  @db.VarChar(80)
  productName String  @map("product_name") @db.VarChar(200)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(15, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  provider        String        @db.VarChar(50)
  externalId      String?       @unique @map("external_id") @db.VarChar(150)
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(15, 2)
  method          String?       @db.VarChar(50)
  paidAt          DateTime?     @map("paid_at")
  providerPayload Json?         @map("provider_payload")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model RefundRequest {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  reason String @db.VarChar(255)
  restock Boolean @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@map("refund_requests")
}

model Quotation {
  order Order?
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  quotationNumber String          @unique @map("quotation_number") @db.VarChar(40)
  projectName     String          @map("project_name") @db.VarChar(200)
  companyName     String?         @map("company_name") @db.VarChar(200)
  contactName     String          @map("contact_name") @db.VarChar(150)
  contactPhone    String          @map("contact_phone") @db.VarChar(32)
  notes           String?         @db.VarChar(1000)
  attachmentUrl   String?         @map("attachment_url") @db.VarChar(500)
  attachmentId String? @map("attachment_id") @db.Uuid
  attachment MediaAsset? @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  status          QuotationStatus @default(SUBMITTED)
  validUntil      DateTime?       @map("valid_until")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           QuotationItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([attachmentId])
  @@map("quotations")
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  purpose String @db.VarChar(20)
  bucket String @db.VarChar(100)
  objectKey String @unique @map("object_key") @db.VarChar(200)
  contentType String @map("content_type") @db.VarChar(100)
  sizeBytes Int @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  quotations Quotation[]
  @@index([ownerId, createdAt])
  @@map("media_assets")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @map("quotation_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  description String    @db.VarChar(300)
  quantity    Int
  unitPrice   Decimal?  @map("unit_price") @db.Decimal(15, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_items")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  channel String @default("EMAIL") @db.VarChar(10)
  userId String? @map("user_id") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  eventKey String @unique @map("event_key") @db.VarChar(200)
  recipient String @db.VarChar(255)
  subject String @db.VarChar(200)
  body String
  status String @default("QUEUED") @db.VarChar(20)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  sentAt DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum AllocationState {
  RESERVED
  CONSUMED
  RELEASED
  RETURNED
}

model Warehouse {
  outboundTransfers WarehouseTransfer[] @relation("TransferSource")
  inboundTransfers WarehouseTransfer[] @relation("TransferDestination")
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(150)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  stocks WarehouseStock[]
  allocations OrderAllocation[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  @@map("warehouses")
}

model WarehouseStock {
  id String @id @default(uuid()) @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Int @default(0)
  reserved Int @default(0)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("warehouse_stocks")
}

model OrderAllocation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  quantity Int
  state AllocationState @default(RESERVED)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  @@unique([orderId, productId, warehouseId])
  @@index([productId, state])
  @@index([warehouseId, state])
  @@map("order_allocations")
}

model WarehouseTransfer {
  id String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  fromWarehouseId String @map("from_warehouse_id") @db.Uuid
  toWarehouseId String @map("to_warehouse_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  quantity Int
  reason String @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse @relation("TransferSource", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse Warehouse @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([productId, createdAt])
  @@map("warehouse_transfers")
}
