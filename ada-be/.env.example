NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://arga_damar:change_me@localhost:5432/arga_damar?schema=public
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key
MIDTRANS_IS_PRODUCTION=false
FRONTEND_URL=http://localhost:3001
SHIPPING_BASE_COST=20000
SHIPPING_PER_KG_COST=5000

# Local email: start the Mailpit service from docker-compose.operations.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Arga Damar Abadi <noreply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
# Enable on one worker only after reviewing expiry policy.
MAINTENANCE_ENABLED=false
ORDER_PAYMENT_TTL_MINUTES=60

# Foto produk: buat bucket PUBLIC product-images di Supabase Storage.
# Nilai ini hanya di backend; jangan gunakan prefix NEXT_PUBLIC untuk key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
STORAGE_IMAGES_BUCKET=product-images
# BOQ harus memakai bucket PRIVATE terpisah dan scanner aktif.
STORAGE_BOQ_BUCKET=boq-private
# CLAMAV_HOST=localhost
CLAMAV_PORT=3310
NOTIFICATIONS_ENABLED=false

# Shipping uses internal tariffs unless explicitly switched to BITESHIP.
SHIPPING_PROVIDER=INTERNAL
# SHIPPING_ORIGIN_POSTAL_CODE=12345
# BITESHIP_API_KEY=
BITESHIP_COURIERS=jne
# Tracking also requires the Biteship shipment tracking ID linked per order.
WHATSAPP_ENABLED=false
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=vXX.X
# Approved utility template: two text body variables (subject and message).
# WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id
